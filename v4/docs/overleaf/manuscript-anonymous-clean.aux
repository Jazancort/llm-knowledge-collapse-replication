\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces $K_0$ retention trajectories over ten recursive generations across three backbones: (a)~Qwen~2.5~1.5B, (b)~Gemma~3~1B, and (c)~Gemma~4~E2B. Shaded bands show the seed range for Gemma~3 ($N=5$) and Qwen ($N=3$); Gemma~4 is a single trajectory ($N=1$, no band); solid lines show means. All three backbones exhibit consistent regime structure (homeostatic below threshold, degradative above), with the transition occurring at backbone-dependent effective-rank values.}}{13}{figure.caption.12}\protected@file@percent }
\newlabel{fig:combined_traj}{{4}{13}{$K_0$ retention trajectories over ten recursive generations across three backbones: (a)~Qwen~2.5~1.5B, (b)~Gemma~3~1B, and (c)~Gemma~4~E2B. Shaded bands show the seed range for Gemma~3 ($N=5$) and Qwen ($N=3$); Gemma~4 is a single trajectory ($N=1$, no band); solid lines show means. All three backbones exhibit consistent regime structure (homeostatic below threshold, degradative above), with the transition occurring at backbone-dependent effective-rank values}{figure.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces $K_0$ retention versus mean effective rank across three backbones. Marker shapes distinguish backbones (circle: Qwen, square: Gemma~3, triangle: E2B); colors indicate regime membership (blue: homeostatic, orange: bounded, red: degradative). The regime transition occurs at substantially different effective-rank values across architectures.}}{13}{figure.caption.13}\protected@file@percent }
\newlabel{fig:cross_backbone}{{5}{13}{$K_0$ retention versus mean effective rank across three backbones. Marker shapes distinguish backbones (circle: Qwen, square: Gemma~3, triangle: E2B); colors indicate regime membership (blue: homeostatic, orange: bounded, red: degradative). The regime transition occurs at substantially different effective-rank values across architectures}{figure.caption.13}{}}
